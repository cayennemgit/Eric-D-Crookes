---
import '../styles/global.css';
import '@fontsource/cormorant-garamond/latin-300.css';
const { title = 'Gallery', description = 'Explore the intuitive, expressive artwork of Canadian artist Eric D. Crookes.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><title>{title} — Eric D. Crookes</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">Eric D. Crookes <span class="artist-description">| abstract | cubist | multimedia artist</span></a>
    </header>
    <main id="main"><slot /></main>
    <footer><a class="footer-name" href="/">Eric D. Crookes</a><span>Art is personal. Find what speaks to you.</span><small>© {new Date().getFullYear()} Eric D. Crookes</small></footer>
  </body>
</html>
